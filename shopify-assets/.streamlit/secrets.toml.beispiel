# Vorlage für die Shopify-Zugangsdaten
# ─────────────────────────────────────────────────────────
# 1. Diese Datei kopieren nach:  .streamlit/secrets.toml
#       cp secrets.toml.beispiel secrets.toml
# 2. Access Token eintragen
# 3. Datei NICHT committen — secrets.toml ist über .gitignore
#    ausgeschlossen, diese Vorlage hier ist es nicht.

shop_domain  = "zwergenladen.myshopify.com"
access_token = "shpat_HIER_DEN_ECHTEN_TOKEN_EINSETZEN"

# Woher der Token kommt:
#   Shopify Admin → Einstellungen → Apps und Vertriebskanäle
#     → Apps entwickeln → App „Zwergenladen"
#     → API-Zugangsdaten → Admin API Access Token
#
# Benötigte Berechtigung:  read_products
#
# Client ID und Client Secret aus dem Dev Dashboard brauchst du hier NICHT.
# Die gehören zum OAuth-Ablauf für Apps auf fremden Shops. Für den Zugriff
# auf den eigenen Shop genügt der Access Token.
