# LinkedIn OAuth 2.0
# Erstelle eine App unter: https://www.linkedin.com/developers/apps
LINKEDIN_CLIENT_ID=your_client_id_here
LINKEDIN_CLIENT_SECRET=your_client_secret_here
LINKEDIN_REDIRECT_URI=http://localhost:8000/auth/callback

# Crunchbase API
# Registrierung unter: https://data.crunchbase.com/docs
CRUNCHBASE_API_KEY=your_crunchbase_key_here

# Apollo.io API
# Account unter: https://developer.apollo.io
APOLLO_API_KEY=your_apollo_key_here

# Session Secret (beliebiger langer zufälliger String)
SECRET_KEY=change-me-to-a-random-secret-key-in-production
